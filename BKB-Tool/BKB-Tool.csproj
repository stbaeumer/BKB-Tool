<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Version>0.9.32</Version>
    <AssemblyVersion>0.9.32</AssemblyVersion>
    <FileVersion>0.9.32</FileVersion>
    <Authors>Stefan Bäumer</Authors>
    <Company>Berufskolleg Borken</Company>
    <Product>BKB-Tool</Product>
    <ApplicationIcon>Icons\BKB-Tool.ico</ApplicationIcon>
    <Copyright>Copyright © 2025 Stefan Bäumer</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Icons\BKB-Tool_256.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Icons\BKB-Tool_512.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Icon-Datei explizit im Projekt (optional) -->
  <ItemGroup>
    <None Update="Icons\BKB-Tool.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="dotenv.net" Version="3.2.1" />
    <PackageReference Include="itext7" Version="9.1.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
    <PackageReference Include="Spectre.Console" Version="0.50.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.50.0" />
  </ItemGroup>
</Project>